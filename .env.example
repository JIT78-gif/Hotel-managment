# Copy this to .env and fill in real values before `docker compose up`.

# ---- Required ----
# Long random string (32+ bytes). Used to sign staff/admin JWTs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
HOTEL_JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ---- Recommended for production ----
# Comma-separated list of origins allowed by CORS.
# Use "*" for fully open (fine for a private demo); set to your real domain in production.
# Example: HOTEL_CORS_ORIGINS=https://botifys.com,https://www.botifys.com
HOTEL_CORS_ORIGINS=*

# ---- Optional ----
# Override the public host ports. The internal container ports stay 8000 / 3000.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# Only needed if the backend lives on a DIFFERENT domain than the frontend
# (e.g. api.botifys.com vs botifys.com). Leave blank for same-host setups
# behind a reverse proxy that routes /ws/* to the backend.
# NEXT_PUBLIC_BACKEND_WS_URL=wss://api.botifys.com

# ---- Seed admin (set BEFORE first run of seed_demo.py) ----
# DEMO_ADMIN_EMAIL=admin@botifys.com
# DEMO_ADMIN_PASSWORD=change-me
# DEMO_STAFF_EMAIL=staff@botifys.com
# DEMO_STAFF_PASSWORD=change-me
